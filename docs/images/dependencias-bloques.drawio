<mxfile host="drawio"><diagram id="dependencias-bloques" name="dependencias-bloques"><mxGraphModel grid="1" gridSize="10" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="x1" value="&lt;b style='font-size:16px'&gt;Orden de construcción por dependencias (sin fechas)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="800" height="30" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;1. Fundaciones&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#4B5563'&gt;carpetas, CI, BD, deploy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="180" height="70" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;2. Login y sesión&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#4B5563'&gt;HU-20..23&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#111827;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="110" width="180" height="70" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;3. Estructuras base&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#4B5563'&gt;E1 Grid · E2 HashTable&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#111827;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="290" width="180" height="70" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;4. Mapa y registro&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#4B5563'&gt;HU-01, 02, 03, 09&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#111827;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="200" width="180" height="70" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;5. Recuperación y colores&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#4B5563'&gt;HU-04, 07, 08, 10 · alg. 5.1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#111827;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="60" width="180" height="70" as="geometry"/></mxCell><mxCell id="b6" value="&lt;b&gt;6. Deshacer e historial&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#4B5563'&gt;HU-05, 06, 17, 18 · Stack, DLL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#111827;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="220" width="180" height="70" as="geometry"/></mxCell><mxCell id="b9" value="&lt;b&gt;9. Recordatorios&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#4B5563'&gt;HU-14..16 · IndexedHeap · 5.4&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#111827;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="380" width="180" height="70" as="geometry"/></mxCell><mxCell id="b7" value="&lt;b&gt;7. Sugerencia&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#4B5563'&gt;HU-11..13 · Heap, Graph, LRU · 5.2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#111827;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="60" width="180" height="70" as="geometry"/></mxCell><mxCell id="b8" value="&lt;b&gt;8. Asistente IA&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#4B5563'&gt;HU-28..30 · Insumap-ai&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#111827;fontFamily=Helvetica;fontSize=12;"