<mxfile host="drawio"><diagram id="flujo-sugerencia" name="flujo-sugerencia"><mxGraphModel grid="1" gridSize="10" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="x1" value="&lt;b style='font-size:16px'&gt;Algoritmo de sugerencia del punto óptimo (R10 a R13) · O(M + k log M)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="s" value="GET /suggestions?k=3" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#111827;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="200" height="44" as="geometry"/></mxCell><mxCell id="a" value="Obtener PatientState&lt;br&gt;(LRUCache, O(1))" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#111827;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="200" height="54" as="geometry"/></mxCell><mxCell id="b" value="&lt;b&gt;E6 Graph.bfs&lt;/b&gt;: radio 1 desde cada&lt;br&gt;microzona usada en las últimas H&lt;sub&gt;v&lt;/sub&gt;=48 h&lt;br&gt;→ conjunto &lt;i&gt;penalized&lt;/i&gt; (HashTable)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#111827;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="200" height="80" as="geometry"/></mxCell><mxCell id="c" value="Para cada microzona z (HashTable index, O(M))" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#111827;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="60" width="260" height="44" as="geometry"/></mxCell><mxCell id="c1" value="ratio = min(h / T&lt;sub&gt;req&lt;/sub&gt;, max_ratio)&lt;br&gt;T&lt;sub&gt;req&lt;/sub&gt; = base