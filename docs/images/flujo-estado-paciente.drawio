<mxfile host="drawio"><diagram id="flujo-estado-paciente" name="flujo-estado-paciente"><mxGraphModel grid="1" gridSize="10" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="x1" value="&lt;b style='font-size:16px'&gt;Ciclo de vida del EstadoPaciente (caché LRU + BD como fuente de verdad)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="s" value="Request del paciente&lt;br&gt;(GET /mapa, POST /inyecciones…)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#111827;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="220" height="50" as="geometry"/></mxCell><mxCell id="q" value="¿paciente en&lt;br&gt;CacheLRU?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="65" y="150" width="170" height="80" as="geometry"/></mxCell><mxCell id="b" value="&lt;b&gt;Construir desde PostgreSQL&lt;/b&gt; O(M + I)&lt;br&gt;• tam_cuadricula → 8 Matrices&lt;br&gt;• última inyección por microzona → TablaHash&lt;br&gt;• usos 30 d → uso_macro&lt;br&gt;• últimas 24 h → Pila&lt;br&gt;• historial → ListaDoble&lt;br&gt;• Matrices → Grafo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E0E7FF;strokeColor=#4169E1;fontColor=#111827;fontFamily=Helvetica;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="330" y="120" width="300" height="150" as="geometry"/></mxCell><mxCell id="p" value="CacheLRU.poner(paciente, estado)&lt;br&gt;(expulsa el menos usado)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#111827;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="300" width="300" height="50" as="geometry"/></mxCell><mxCell id="u" value="&lt;b&gt;Estado disponible&lt;/b&gt;&lt;br&gt;(CacheLRU.obtener → al frente O(1))" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#111827;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="220" height="50" as="geometry"/></mxCell><mxCell id="w" value="¿Operación de&lt;br&gt;escritura?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="65" y="390" width="170" height="80" as="geometry"/></mxCell><mxCell id="tx" value="&lt;b&gt;Transacción&lt;/b&gt;&lt;br&gt;1) escribir en BD&lt;br&gt;2) actualizar estructuras en memoria&lt;br&gt;3) si falla → CacheLRU.invalidar" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#111827;fontFamily=Helvetica;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="330" y="380" width="300" height="100" as="geometry"/></mxCell><mxCell id="r" value="Responder con el estado (mapa / sugerencias / historial)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#111827;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="220" height="60" as="geometry"/></mxCell><mxCell id="e" value="Fin" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#111827;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="65" y="620" width="170" height="44" as="geometry"/></mxCell><mxCell id="x2" value="Si el proceso se reinicia (deploy, Render duerme) la caché queda vacía y el estado se reconstruye desde la BD en el siguiente request: la BD es la fuente de verdad." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontFamily=Helvetica;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="680" y="140" width="240" height="110" as="geometry"/></mxCell><mxCell id="x3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#374151;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s" target="q"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x4" value="sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#374151;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="q" target="u"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x5" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#374151;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="q" target="b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#374151;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b" target="p"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x7" value="listo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#374151;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="p" target="u"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#374151;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="u" target="w"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x9" value="sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#374151;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="w" target="tx"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x10" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#374151;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="w" target="r"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#374151;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="tx" target="r"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#374151;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="r" target="e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>