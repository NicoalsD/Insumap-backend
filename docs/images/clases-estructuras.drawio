<mxfile host="drawio"><diagram id="clases-estructuras" name="clases-estructuras"><mxGraphModel grid="1" gridSize="10" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="x1" value="&lt;b style='font-size:16px'&gt;Diagrama de clases - estructuras de datos propias (app/domain/structures)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="ep" value="&amp;laquo;dominio&amp;raquo;&lt;br&gt;&lt;b&gt;EstadoPaciente&lt;/b&gt;" style="swimlane;html=1;startSize=40;fillColor=#EDE9FE;strokeColor=#7C3AED;swimlaneFillColor=#FFFFFF;fontFamily=Helvetica;fontSize=12;collapsible=0;" vertex="1" parent="1"><mxGeometry x="420" y="50" width="330" height="200" as="geometry"/></mxCell><mxCell id="x2" value="+ cuadriculas: TablaHash[(macro,lado) → Matriz]&lt;br&gt;+ indice: TablaHash[str → Microzona]&lt;br&gt;+ vecindad: Grafo&lt;br&gt;+ deshacer: Pila[AccionRegistro]&lt;br&gt;+ historial: ListaDoble[Inyeccion]&lt;br&gt;+ uso_macro: TablaHash[str → int]" style="text;html=1;align=left;spacingLeft=6;verticalAlign=top;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="ep"><mxGeometry x="0" y="40" width="330" height="104" as="geometry"/></mxCell><mxCell id="x3" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#374151;fontFamily=Helvetica;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;endArrow=none;strokeColor=#7C3AED;" edge="1" parent="ep"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="144" as="sourcePoint"/><mxPoint x="330" y="144" as="targetPoint"/></mxGeometry></mxCell><mxCell id="x4" value="+ registrar(id, t) / deshacer()&lt;br&gt;+ sugerir(k): list&lt;br&gt;+ mapa(): dict" style="text;html=1;align=left;spacingLeft=6;verticalAlign=top;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="ep"><mxGeometry x="0" y="144" width="330" height="56" as="geome