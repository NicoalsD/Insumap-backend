<mxfile host="drawio"><diagram id="capas-backend" name="capas-backend"><mxGraphModel grid="1" gridSize="10" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="x1" value="&lt;b style='font-size:16px'&gt;Arquitectura en capas de Insumap-backend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="30" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;api/v1&lt;/b&gt; - Routers FastAPI&lt;br&gt;&lt;font color='#6B7280'&gt;auth · mapa · inyecciones · sugerencias · cronograma · recordatorios · historial · vinculos · medico · asistente · internal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#111827;fontFamily=Helvetica;fontSize=12;align=left;spacingLeft=70;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="620" height="80" as="geometry"/></mxCell><mxCell id="x2" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;imageAspect=1;aspect=fixed;fontFamily=Helvetica;fontSize=11;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="75" y="80" width="40" height="40" as="geometry"/></mxCell><mxCell id="svc" value="&lt;b&gt;services&lt;/b&gt; - Casos de uso y transacciones&lt;br&gt;&lt;font color='#6B7280'&gt;InyeccionService · SugerenciaService · RecordatorioService · AuthService · VinculoService · AsistenteService · ExportService&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#111827;fontFamily=Helvetica;fontSize=12;align=left;spacingLeft=70;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="620" height="80" as="geometry"/></mxCell><mxCell id="dom" value="&lt;b&gt;domain&lt;/b&gt; - Núcleo sin dependencias de framework&lt;br&gt;&lt;font color='#6B7280'&gt;structures/ (E1-E7) · alg