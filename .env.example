# Copy to .env and adjust. Never commit .env.
ENVIRONMENT=local
# postgresql:// or postgresql+psycopg:// both work. With Neon, `neon link` / `neon deploy` fill these in.
DATABASE_URL=postgresql+psycopg://insumap:insumap@localhost:5432/insumap
# Direct (non-pooled) URL used only by Alembic migrations (Neon: DATABASE_URL_UNPOOLED). Optional.
DATABASE_URL_UNPOOLED=

JWT_SECRET=change-me-in-production-please-32b
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Local http: COOKIE_SECURE=false / COOKIE_SAMESITE=lax. Production (Vercel + Render): true / none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Reminders: in-process scheduler + external cron hitting /api/v1/internal/reminders/tick
SCHEDULER_ENABLED=true
CRON_TOKEN=change-me-cron
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:insumap@example.com

# Email (empty SMTP_HOST = log emails to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Insumap <no-reply@insumap.local>

# Insumap-ai service (empty = assistant answers in degraded/template mode)
AI_SERVICE_URL=
AI_SERVICE_TOKEN=

# Demo users paciente@demo.insumap / medico@demo.insumap (password Insumap123). Disable in production.
SEED_DEMO_USERS=true
